{% set navItems = [
  { href: "/", label: "Inicio" },
  { href: "/cursos/", label: "Cursos" },
  { href: "/consultoria/", label: "Consultoría" },
  { href: "/nosotros/", label: "Sobre nosotros" },
  { href: "/contacto/", label: "Contacto" }
] %}
<header class="site-header">
  <div class="wrap">
    <a href="/" class="logo-link" aria-label="PraxEvo — inicio">
      <img class="logo" src="/assets/img/logo-primary.svg" alt="PraxEvo" width="150" height="32">
    </a>

    <nav class="primary-nav" aria-label="Navegación principal">
      {% for item in navItems %}
        <a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <a href="/contacto/" class="btn btn-dark nav-cta">Agenda una consultoría</a>
    </nav>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  {% for item in navItems %}
    <a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
  {% endfor %}
  <a href="/contacto/" class="btn btn-dark">Agenda una consultoría</a>
</div>
