{# Regla de revisión cambiaria (ENC-0001, aprobada 2026-08-03): si la TRM del Banco de la República supera 3.785 COP/USD, este precio en pesos (COP 299.000) debe revisarse — a esa TRM equivale a USD 79, el piso del manual de marca. #}
{% set courses = [
  { id: 1, title: "Del caos operativo al cliente fidelizado", priceUsd: "USD 97", priceCop: "COP 299.000", installments: "12 cuotas de COP 24.917/mes" }
] %}

<section class="page-hero">
  <div class="wrap">
    <p class="kicker">PraxEvo Academy</p>
    <h1>Cursos online de CX y Operaciones</h1>
    <p>Metodología práctica, casos reales de aviación y fintech, disponible en Hotmart. Precio de referencia de lanzamiento: <strong style="color:var(--white);">USD $97</strong>.</p>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="grid grid-3">
      {% for c in courses %}
      <div class="card" data-course-card>
        <div class="card-thumb">Miniatura del curso</div>
        <div class="card-body">
          <h3>{{ c.title }}</h3>
          <p><span class="pending-badge">Descripción pendiente — Marca y Contenido</span></p>
          <div class="card-foot" style="flex-direction:column; align-items:flex-start; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
              <span class="price">{{ c.priceUsd }} · {{ c.priceCop }}</span>
              <a href="/contacto/" class="cta-link">Escríbenos para inscribirte →</a>
              {# TODO: reemplazar por el enlace real de Hotmart cuando Academy publique el curso #}
            </div>
            <span style="font-size:12px; color:var(--muted);">{{ c.installments }}</span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="block bg-light text-center">
  <div class="wrap">
    <h2 style="font-size:clamp(22px,3vw,28px); margin-bottom:20px;">¿No sabes por dónde empezar?</h2>
    <a href="/contacto/" class="btn btn-dark">Agenda un diagnóstico gratuito</a>
  </div>
</section>
