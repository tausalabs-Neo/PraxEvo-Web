      <svg class="icon-stroke icon-layer3" viewBox="0 0 48 48" fill="none" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="8" y="6" width="32" height="8" rx="2"></rect>
        <rect x="8" y="20" width="32" height="8" rx="2"></rect>
        <rect x="8" y="34" width="32" height="8" rx="2"></rect>
        <path d="M24 14 L24 20 M24 28 L24 34"></path>
